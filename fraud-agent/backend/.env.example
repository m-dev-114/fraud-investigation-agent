# Supabase Postgres connection string.
# Get this from Supabase -> Project Settings -> Database -> Connection string (URI).
# Use the "Session pooler" or "Transaction pooler" connection string for Render.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Optional. If unset, the deterministic investigation engine is used automatically
# and the LLM narrative layer is skipped -- the app still works fully.
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# Comma-separated list of allowed frontend origins for CORS.
# Add your Vercel URL(s) here, e.g. https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173

ENV=production
PORT=8000
